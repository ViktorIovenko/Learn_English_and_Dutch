<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login_language"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:text="@string/interface_language" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login_theme"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:text="@string/theme_title" />
        </LinearLayout>

        <ImageView
            android:id="@+id/img_login_mark"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="40dp"
            android:contentDescription="@string/app_name"
            android:cropToPadding="true"
            android:scaleType="matrix"
            android:src="@drawable/logo_mark" />

        <ImageView
            android:id="@+id/img_login_name"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/app_name"
            android:cropToPadding="true"
            android:scaleType="matrix"
            android:src="@drawable/header_wordmark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="36dp"
            android:text="@string/login_subtitle"
            android:textSize="15sp"
            android:textColor="@color/colorTextSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:textAllCaps="false"
            android:textSize="15.5sp"
            android:textColor="@color/colorOnBackground"
            android:text="@string/btn_google_login"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:strokeColor="@color/colorGoogleButtonBorder"
            app:strokeWidth="1dp"
            app:rippleColor="@color/colorPanelBackground"
            app:cornerRadius="28dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_telegram_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:paddingStart="8dp"
            android:textAllCaps="false"
            android:textSize="15.5sp"
            android:text="@string/btn_telegram_login"
            android:backgroundTint="@color/colorTelegram"
            app:icon="@drawable/ic_telegram"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_email_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:paddingStart="8dp"
            android:textAllCaps="false"
            android:textSize="15.5sp"
            android:textColor="@color/colorPrimaryVariant"
            android:text="@string/btn_email_login"
            app:icon="@drawable/ic_email"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            app:strokeColor="@color/colorPrimaryVariant"
            app:strokeWidth="1dp"
            app:cornerRadius="28dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <LinearLayout
            android:id="@+id/email_login_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="@string/auth_email_address"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="@string/hint_password"
                app:passwordToggleEnabled="true" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email_password" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPassword" android:autofillHints="password" android:singleLine="true"
                    android:imeOptions="actionGo" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_email_submit" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textAllCaps="false" android:text="@string/btn_login" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_email_register" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="@string/auth_create_account"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_email_reset" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAllCaps="false" android:text="@string/auth_forgot_password"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
