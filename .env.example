# ParallelLingvo production environment template
# Never commit real secrets. Copy this file to .env on the server.

# Flask
FLASK_SECRET=replace-with-a-long-random-secret
FLASK_HOST=0.0.0.0
FLASK_PORT=7001
FLASK_DEBUG=0

# Domains
SITE_BASE_URL=https://parallellingvo.app
APP_BASE_URL=https://app.parallellingvo.app
PUBLIC_BASE_URL=https://app.parallellingvo.app

# Branded Telegram bot used by both the Mini App and Telegram Login
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Modern Telegram Login / OpenID Connect credentials
# BotFather -> your bot -> Login Widget -> OpenID Connect Login
# Redirect URI registered in BotFather:
# https://app.parallellingvo.app/auth/telegram/callback
# Trusted origins:
# https://parallellingvo.app
# https://app.parallellingvo.app
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# Google OAuth / OIDC credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Security: keep disabled in production.
ALLOW_LEGACY_UID_AUTH=0

# Legacy bot registration password (normally leave empty for the public branded bot)
BOT_PASSWORD=

# Optional audio settings
AUDIO_MAXIMIZE=1
AUDIO_PEAK_DBFS=-0.1
AUDIO_COMP_THRESHOLD_DBFS=-18
AUDIO_COMP_RATIO=6.0
AUDIO_COMP_ATTACK_MS=3
AUDIO_COMP_RELEASE_MS=80
AUDIO_MP3_BITRATE=256k
